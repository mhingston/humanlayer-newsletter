# Required — Firecrawl API key (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-key-here

# Required — the HumanLayer blog index page
SOURCE_URL=https://www.humanlayer.dev/blog

# Required — feed metadata
FEED_TITLE=HumanLayer Blog
FEED_DESCRIPTION=Posts from humanlayer.dev/blog — coding agents, context engineering, and harness design by Dex & Kyle
PUBLIC_BASE_URL=https://mhingston.github.io/humanlayer-newsletter

# Optional — link back to the source site in the feed itself
FEED_SITE_URL=https://www.humanlayer.dev
FEED_LANGUAGE=en
FEED_AUTHOR=HumanLayer
FEED_COPYRIGHT=HumanLayer

# Optional — output filenames served from PUBLIC_BASE_URL
ATOM_FILENAME=feed.atom.xml
RSS_FILENAME=feed.rss.xml

# Optional — feed sizing
MAX_FEED_ITEMS=100
INITIAL_ITEM_LIMIT=20

# Optional — supplemental instruction forwarded to Firecrawl alongside the
# built-in extraction prompt. Leave blank unless Firecrawl misidentifies
# HumanLayer's listing page; a narrow hint usually fixes that.
EXTRACTION_HINT=

# Optional — Firecrawl request tuning
FIRECRAWL_TIMEOUT_MS=120000
FIRECRAWL_MAX_AGE_MS=0
FIRECRAWL_ONLY_MAIN_CONTENT=true
FIRECRAWL_PROXY=auto